# Both keys are required: there is no mock or sample data.
# YouCam Skin AI (server-side only) - see lib/youcam.ts callYouCamLive()
YOUCAM_API_KEY=
# SerpApi Google Shopping - see app/api/marketplace/route.ts
SERPAPI_API_KEY=
# YouCam secret key (RSA public key used to sign auth requests), server-side only
YOUCAM_SECRET_KEY=
# Neon Auth + database (server-side only)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
DATABASE_URL=
# Google Gemini (server-side only): reads ingredient labels on /api/analyze-bottle
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash)
GEMINI_MODEL=
